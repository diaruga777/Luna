<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>LunaMicrosoftClientID</key>
	<string>592c7c13-5ce7-4d75-a398-2527212398ff</string>
	<key>LunaAppGroupID</key>
	<string>$(APP_GROUP_ID)</string>
	<key>LunaCloudKitContainerID</key>
	<string>iCloud.$(PRODUCT_BUNDLE_PREFIX)</string>
	<key>LunaCoreAppStoreURL</key>
	<string>$(LUNA_CORE_APP_STORE_URL)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSCameraUsageDescription</key>
	<string>Luna tracks your eyes to pause playback automatically when you look away.</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Luna connects to your Xteink reader to deliver saved articles when it wakes.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Luna looks for your paired Xteink e-reader on your Wi-Fi network to transfer saved articles.</string>
	<key>NSAccessorySetupKitSupports</key>
	<array>
		<string>Bluetooth</string>
	</array>
	<key>NSAccessorySetupBluetoothServices</key>
	<array>
		<string>6F9F0A00-9B1D-4D1F-9F53-5B6B8B3D0F10</string>
	</array>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Luna saves photos, GIFs, and videos from social posts to your photo library.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Luna loads media you saved to Photos so it remains available in Luna Video.</string>
	<!-- The Luna file family (claudedocs/luna-file.md). All four apps export
	     the same four declarations: an exporter set that agrees is harmless,
	     and it means each app knows the family's types whether or not its
	     siblings are installed. The three sibling types CONFORM to the central
	     one, so the central app's single document type below opens all four. -->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>$(PRODUCT_BUNDLE_PREFIX).file</string>
			<key>UTTypeDescription</key>
			<string>Luna file</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.plain-text</string>
				<string>public.content</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>luna</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>$(PRODUCT_BUNDLE_PREFIX).reader.file</string>
			<key>UTTypeDescription</key>
			<string>Luna Reader file</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>$(PRODUCT_BUNDLE_PREFIX).file</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>lunar</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>$(PRODUCT_BUNDLE_PREFIX).downloader.file</string>
			<key>UTTypeDescription</key>
			<string>Luna Video file</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>$(PRODUCT_BUNDLE_PREFIX).file</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>lunad</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>$(PRODUCT_BUNDLE_PREFIX).pricetracker.file</string>
			<key>UTTypeDescription</key>
			<string>Luna Price Tracker file</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>$(PRODUCT_BUNDLE_PREFIX).file</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>lunas</string>
				</array>
			</dict>
		</dict>
	</array>
	<!-- $(LUNA_DOC_UTI) is set per app target in project.pbxproj beside
	     $(LUNA_URL_SCHEME), so each app claims only the files addressed to it. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Luna file</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>$(LUNA_DOC_UTI)</string>
			</array>
			<key>LSHandlerRank</key>
			<string>Owner</string>
		</dict>
	</array>
	<!-- Luna copies the file out of its inbox and deletes it, so there is
	     nothing to edit in place. -->
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<false/>
	<key>CFBundleURLTypes</key>
	<array>
		<!-- $(LUNA_URL_SCHEME) is set per app target (lunareader / lunadownloader /
		     lunapricetracker) so each app registers ONLY its own scheme even though
		     all three share this Info.plist. -->
		<dict>
			<key>CFBundleURLName</key>
			<string>com.hsanabria.luna.friend</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(LUNA_URL_SCHEME)</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.hsanabria.luna.read</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(LUNA_URL_SCHEME)</string>
			</array>
		</dict>
	</array>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>twitter</string>
		<string>x</string>
		<string>bluesky</string>
		<string>reddit</string>
		<string>spotify</string>
		<string>music</string>
		<string>podcasts</string>
		<string>tiktok</string>
		<string>snssdk1233</string>
		<string>instagram</string>
		<string>fb</string>
		<!-- The two LLM hand-off targets (claudedocs/luna-file.md). Queried so
		     the recovery row can pick the app link over the web form. -->
		<string>chatgpt</string>
		<string>claude</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.hsanabria.luna.mailFetch</string>
		<string>com.hsanabria.luna.priceRefresh</string>
		<string>com.hsanabria.luna.weeklyProposalCheck</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>remote-notification</string>
		<string>fetch</string>
		<string>processing</string>
		<string>bluetooth-central</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
</dict>
</plist>
