{
    "manifest_version": 3,
    "name": "Clip",
    "description": "Tracks the page you're reading so Clip can save it to your reading list, and adds a Read-in-Queue button on paywalled articles.",
    "version": "1.0",
    "icons": {
        "48": "icon-48.png",
        "64": "icon-64.png",
        "96": "icon-96.png",
        "128": "icon-128.png",
        "256": "icon-256.png",
        "512": "icon-512.png"
    },
    "background": {
        "page": "background.html",
        "persistent": false
    },
    "content_scripts": [
        {
            "matches": [
                "*://*.wsj.com/*", "*://*.ft.com/*", "*://*.nytimes.com/*",
                "*://*.economist.com/*", "*://*.bloomberg.com/*", "*://*.washingtonpost.com/*",
                "*://*.newyorker.com/*", "*://*.theatlantic.com/*", "*://*.wired.com/*",
                "*://*.barrons.com/*", "*://*.businessinsider.com/*", "*://*.theinformation.com/*",
                "*://*.hbr.org/*", "*://*.foreignpolicy.com/*", "*://*.foreignaffairs.com/*",
                "*://*.thetimes.co.uk/*", "*://*.telegraph.co.uk/*", "*://*.nikkei.com/*",
                "*://*.seekingalpha.com/*", "*://*.latimes.com/*", "*://*.bostonglobe.com/*",
                "*://archive.is/*", "*://archive.ph/*", "*://archive.md/*",
                "*://archive.today/*", "*://archive.li/*", "*://archive.vn/*", "*://archive.fo/*"
            ],
            "js": ["content.js"],
            "run_at": "document_idle",
            "all_frames": false
        }
    ],
    "permissions": ["nativeMessaging", "tabs"],
    "host_permissions": ["<all_urls>"]
}
