// Luna — single source of truth for product identity.
//
// ┌──────────────────────────────────────────────────────────────────────────┐
// │  TO RENAME THE WHOLE PRODUCT, EDIT ONLY THE TWO LINES BELOW.               │
// │  Everything else — bundle IDs, the shared App Group, and the in-code      │
// │  identifiers (via injected Info.plist keys) — derives from them.          │
// │  "luna" is a placeholder.                                                │
// └──────────────────────────────────────────────────────────────────────────┘
LUNA_NAMESPACE = luna
COMPANY_PREFIX = com.hsanabria

// ── Derived identifiers (do not edit) ───────────────────────────────────────
PRODUCT_BUNDLE_PREFIX = $(COMPANY_PREFIX).$(LUNA_NAMESPACE)

// The App Group is SHARED across all Luna apps and every bundled extension, so
// it carries the namespace prefix WITHOUT a per-app suffix. This is what lets a
// link saved in any app surface land in one shared store.
APP_GROUP_ID = group.$(PRODUCT_BUNDLE_PREFIX)

// The iCloud container is shared by the apps that opt into an iCloud
// capability. Targets without an iCloud entitlement do not gain access merely
// by inheriting this build setting.
ICLOUD_CONTAINER_ID = iCloud.$(PRODUCT_BUNDLE_PREFIX)

// Human-visible app name prefix, e.g. "Luna Reader".
DISPLAY_NAME_PREFIX = Luna

// The central app's App Store Connect record ("Luna: Save Anything", created
// 2026-08-13 with app id 6800900997).
// `$()` preserves `//` inside an xcconfig value instead of starting a comment.
LUNA_CORE_APP_STORE_URL = https:/$()/apps.apple.com/app/id6800900997

// Lets read-aloud playback (claudedocs/audio-playback.md) keep going once the
// user leaves the app. Project-level base config, so it reaches all four app
// targets (and is harmlessly inert on the extension targets and the two apps
// that link no audio module, which never start playback).
INFOPLIST_KEY_UIBackgroundModes = audio

// Compile every .metal source as a CORE IMAGE kernel library. The only Metal in
// the project is `LunaWaveKernels.ci.metal` (the save wave's kernels, loaded
// from the app bundle's default.metallib by `LiquidScreenWaveAnimator`); if a
// rendering .metal file ever arrives, move it to its own target or split these
// flags per-target, because the two compile modes are mutually exclusive.
MTL_COMPILER_FLAGS = -fcikernel
MTLLINKER_FLAGS = -fcikernel

// Core Image Kernel Language (`CIWarpKernel(source:)` / `CIColorKernel(source:)`)
// has been deprecated since iOS 12, and the Metal-library constructors that
// replace it are what `OnboardingActionButtonEffects` reaches for FIRST. The
// CIKL spellings survive only as its fallback for a missing `default.metallib`
// — the one case the replacement cannot serve, since it needs that library —
// so there is nothing to migrate them to. This define is Apple's own escape
// hatch for exactly that, named in the deprecation message itself; it reaches
// the Swift importer through the CoreImage headers.
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) CI_SILENCE_GL_DEPRECATION=1
