{
    "manifest_version": 3,
    "name": "Luna",
    "description": "Tracks the page you're reading so Luna can save it to your reading list.",
    "version": "1.0",
    "icons": {
        "48": "icon-48.png",
        "64": "icon-64.png",
        "96": "icon-96.png",
        "128": "icon-128.png",
        "256": "icon-256.png",
        "512": "icon-512.png"
    },
    "background": {
        "page": "background.html",
        "persistent": false
    },
    "permissions": ["nativeMessaging", "tabs", "scripting"],
    "host_permissions": ["<all_urls>"]
}
