<?xml version="1.0" encoding="UTF-8"?>
<!--
    The launch screen, built out of CONSTRAINTS.

    It used to be one full-screen raster recorded on a 402x874 iPhone and pinned
    to every edge with contentMode=scaleToFill, so the card inside it was the
    right size on exactly that one device and a non-uniform stretch of it
    everywhere else. What it draws now is the same rule the live deck uses
    (CardDeckGeometry): a card area below the safe area plus the deck's 48pt
    chrome clearance and above the 104pt scrub-strip runway, with the largest
    exact-9:16 card centered in it — capped at half the width minus padding once
    the screen is iPad-wide.

    Reading the numbers, all of which have a named Swift counterpart:
      48         CardDeckGeometry.topClearance
      104        CardDeckGeometry.bottomChromeHeight (96pt strip + 8pt gap)
      24         CardCarouselMetrics.peek + edgeGap (14 + 10), doubled to 48
      12         CardCarouselMetrics.verticalPadding, doubled to 24
      0.5 / -36  LunaLayout.cardWidthCap: width/2 - wideEdgePadding - columnGap/2
      1.84       AppLaunchGeometry.coronaWidthMultiple (1 + 2 * 0.42)
      0.7029     AppLaunchGeometry.coronaAspectRatio
    LaunchScreenGeometryTests loads this file and checks the resulting frames
    against those constants at six screen sizes, so the two cannot drift.

    The width cap is the one genuinely conditional rule — a cliff at 700pt
    (LunaLayout.wideThreshold), and a launch storyboard has no way to express a
    step function — so it is installed by default and EXCLUDED in the
    compact-width variation. Every iPhone Luna ships to is compact-width in
    portrait; an iPad at full width is regular, and a half-width iPad window is
    compact, which is the same call LunaLayout makes about it.
-->
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="26504" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" launchScreen="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="launch-controller">
    <device id="retina6_12" orientation="portrait" appearance="dark"/>
    <dependencies>
        <deployment identifier="iOS"/>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="26502"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="System colors in document resources" minToolsVersion="11.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <scene sceneID="launch-scene">
            <objects>
                <viewController id="launch-controller" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="launch-root">
                        <rect key="frame" x="0.0" y="0.0" width="402" height="874"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <!-- The sky. scaleToFill, not aspectFill: the live
                                 AppLaunchStarfieldView places every star at a
                                 FRACTION of its bounds, so stretching the raster
                                 the same way keeps the stars exactly where the
                                 app's own first frame puts them. A 1pt dot at
                                 alpha 0.03-0.2 does not read as an ellipse. -->
                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleToFill" image="LunaLaunchStarfield" translatesAutoresizingMaskIntoConstraints="NO" id="launch-starfield">
                                <rect key="frame" x="0.0" y="0.0" width="402" height="874"/>
                            </imageView>
                            <!-- The card AREA: the room the deck fits cards into. -->
                            <view contentMode="scaleToFill" userInteractionEnabled="NO" translatesAutoresizingMaskIntoConstraints="NO" id="launch-card-area">
                                <rect key="frame" x="0.0" y="110" width="402" height="626"/>
                                <color key="backgroundColor" white="0.0" alpha="0.0" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                            </view>
                            <!-- The card itself, as a layout anchor only: the
                                 black body and its rim are inside the corona
                                 artwork, because a launch storyboard cannot
                                 round a corner. -->
                            <view contentMode="scaleToFill" userInteractionEnabled="NO" translatesAutoresizingMaskIntoConstraints="NO" id="launch-card">
                                <rect key="frame" x="31.5" y="122" width="338.5" height="602"/>
                                <color key="backgroundColor" white="0.0" alpha="0.0" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                            </view>
                            <!-- Corona, black card body and rim, in one raster
                                 whose canvas IS the card grown by its
                                 proportional reach. Cropping off the display is
                                 deliberate: the light does not stop at the bezel. -->
                            <imageView clipsSubviews="NO" userInteractionEnabled="NO" contentMode="scaleToFill" image="LunaLaunchCoronaCard" translatesAutoresizingMaskIntoConstraints="NO" id="launch-corona">
                                <rect key="frame" x="-110.5" y="-20" width="623" height="886.5"/>
                            </imageView>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="launch-safe-area"/>
                        <color key="backgroundColor" systemColor="systemBackgroundColor"/>
                        <constraints>
                            <constraint firstItem="launch-starfield" firstAttribute="leading" secondItem="launch-root" secondAttribute="leading" id="sky-leading"/>
                            <constraint firstAttribute="trailing" secondItem="launch-starfield" secondAttribute="trailing" id="sky-trailing"/>
                            <constraint firstItem="launch-starfield" firstAttribute="top" secondItem="launch-root" secondAttribute="top" id="sky-top"/>
                            <constraint firstAttribute="bottom" secondItem="launch-starfield" secondAttribute="bottom" id="sky-bottom"/>

                            <constraint firstItem="launch-card-area" firstAttribute="leading" secondItem="launch-root" secondAttribute="leading" id="area-leading"/>
                            <constraint firstAttribute="trailing" secondItem="launch-card-area" secondAttribute="trailing" id="area-trailing"/>
                            <constraint firstItem="launch-card-area" firstAttribute="top" secondItem="launch-safe-area" secondAttribute="top" constant="48" id="area-top"/>
                            <constraint firstItem="launch-safe-area" firstAttribute="bottom" secondItem="launch-card-area" secondAttribute="bottom" constant="104" id="area-bottom"/>

                            <constraint firstItem="launch-card" firstAttribute="centerX" secondItem="launch-card-area" secondAttribute="centerX" id="card-center-x"/>
                            <constraint firstItem="launch-card" firstAttribute="centerY" secondItem="launch-card-area" secondAttribute="centerY" id="card-center-y"/>
                            <constraint firstItem="launch-card" firstAttribute="width" secondItem="launch-card" secondAttribute="height" multiplier="9:16" id="card-aspect"/>
                            <constraint firstItem="launch-card" firstAttribute="height" relation="lessThanOrEqual" secondItem="launch-card-area" secondAttribute="height" constant="-24" id="card-height-limit"/>
                            <constraint firstItem="launch-card" firstAttribute="width" relation="lessThanOrEqual" secondItem="launch-card-area" secondAttribute="width" constant="-48" id="card-width-limit"/>
                            <constraint firstItem="launch-card" firstAttribute="height" secondItem="launch-card-area" secondAttribute="height" constant="-24" priority="999" id="card-grow"/>
                            <constraint firstItem="launch-card" firstAttribute="width" relation="lessThanOrEqual" secondItem="launch-root" secondAttribute="width" multiplier="0.5" constant="-36" id="card-wide-cap"/>

                            <constraint firstItem="launch-corona" firstAttribute="centerX" secondItem="launch-card" secondAttribute="centerX" id="corona-center-x"/>
                            <constraint firstItem="launch-corona" firstAttribute="centerY" secondItem="launch-card" secondAttribute="centerY" id="corona-center-y"/>
                            <constraint firstItem="launch-corona" firstAttribute="width" secondItem="launch-card" secondAttribute="width" multiplier="1.84" id="corona-width"/>
                            <constraint firstItem="launch-corona" firstAttribute="width" secondItem="launch-corona" secondAttribute="height" multiplier="0.7028862478777589" id="corona-aspect"/>
                        </constraints>
                        <variation key="widthClass=compact">
                            <mask key="constraints">
                                <exclude reference="card-wide-cap"/>
                            </mask>
                        </variation>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="launch-responder" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="114" y="116"/>
        </scene>
    </scenes>
    <resources>
        <image name="LunaLaunchCoronaCard" width="1869" height="2659"/>
        <image name="LunaLaunchStarfield" width="1206" height="2622"/>
        <systemColor name="systemBackgroundColor">
            <color red="0.0" green="0.0" blue="0.0" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
        </systemColor>
    </resources>
</document>
