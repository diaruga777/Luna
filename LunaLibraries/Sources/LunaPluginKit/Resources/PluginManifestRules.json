{
  "comment": "Manifest limits and enum values shared by PluginManifestParser and tools/plugin-sim/manifest.mjs. Shared acceptance fixtures test behavior as well as constants.",
  "api": {
    "current": 1
  },
  "source": {
    "maxKB": 1024
  },
  "id": {
    "characters": "abcdefghijklmnopqrstuvwxyz0123456789.-",
    "maxLength": 100,
    "forbidsLeadingDot": true,
    "forbidsTrailingDot": true,
    "forbidsDoubleDot": true
  },
  "name": {
    "maxLength": 40
  },
  "description": {
    "maxLength": 200
  },
  "version": {
    "maxLength": 32,
    "pattern": "^\\d{1,9}\\.\\d{1,9}\\.\\d{1,9}$"
  },
  "kinds": [
    "article",
    "media",
    "product"
  ],
  "capabilities": [
    "fetch",
    "html",
    "page",
    "storage",
    "secrets",
    "files",
    "crypto",
    "browser",
    "downloads",
    "settings",
    "ui",
    "mail",
    "notifications",
    "bluetooth",
    "wifi",
    "exports"
  ],
  "exportInputFormats": [
    "url",
    "epub",
    "pdf",
    "docx",
    "markdown",
    "text",
    "html",
    "json",
    "file"
  ],
  "settingTypes": [
    "text",
    "email",
    "url",
    "password",
    "number",
    "toggle",
    "choice",
    "pairedDevice",
    "action",
    "info"
  ],
  "hooks": [
    "classify",
    "ingest",
    "export",
    "onBluetooth",
    "onSettingsChanged",
    "onAction"
  ],
  "exportInputsByKind": {
    "article": [
      "url",
      "epub",
      "pdf",
      "docx",
      "markdown",
      "text",
      "html",
      "json"
    ],
    "media": [
      "url",
      "json",
      "file"
    ],
    "product": [
      "url",
      "json"
    ]
  }
}
